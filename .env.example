# Bind the bridge locally and put TLS/auth in front of it.
TUI_HOST=127.0.0.1
TUI_PORT=7690

# The Linux user's home directory.
TUI_HOME=/home/your-user

# Default: attach to a tmux session named claude-code.
TMUX_SESSION=claude-code

# Optional custom tmux socket. Leave blank for the default tmux socket.
TMUX_SOCKET=

# Optional tmux executable (also honored by scripts/create-session.sh).
TMUX_BIN=/usr/bin/tmux

# Optional: override the whole child command instead of tmux attach.
# TUI_COMMAND=/usr/bin/tmux attach-session -t claude-code
