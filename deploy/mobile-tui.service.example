[Unit]
Description=Mobile TUI Remote WebSocket bridge
After=network.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/opt/mobile-tui-remote
EnvironmentFile=/etc/mobile-tui-remote.env
ExecStart=/opt/mobile-tui-remote/.venv/bin/python /opt/mobile-tui-remote/server.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
